/* ═══════════════════════════════════════════════════════════
   learn-duckdb — Premium Tokyo Night + DuckDB Golden Amber
   Crafted using tui-design-skill principles
   ═══════════════════════════════════════════════════════════ */

/* ─── Global Surface ─── */
Screen {
    background: #1a1b26;
    color: #c0caf5;
    layers: base modal;
}

/* ─── Header ─── */
Header {
    background: #16161e;
    color: #FEC62E;
    dock: top;
    height: 1;
}

/* ─── Footer ─── */
Footer {
    background: #16161e;
    color: #565f89;
    dock: bottom;
    height: 1;
}

FooterKey {
    color: #FEC62E;
    background: #16161e;
}

/* ─── Main Container (Flexible Layout) ─── */
#main-container {
    layout: horizontal;
    height: 1fr;
    width: 1fr;
}

/* ─── Sidebar (Responsive, Resizable & Collapsible) ─── */
#sidebar {
    width: 28;
    min-width: 18;
    max-width: 65;
    height: 1fr;
    background: #16161e;
    padding: 0 1;
}

#sidebar.-hidden {
    display: none;
}

#sidebar-handle {
    width: 1;
    height: 1fr;
    background: #16161e;
    color: #292e42;
    text-align: center;
}

#sidebar-handle.-hidden {
    display: none;
}

#sidebar-handle:hover, #sidebar-handle.-active {
    background: #24283b;
    color: #FEC62E;
}

#sidebar-title {
    text-style: bold;
    color: #FEC62E;
    padding: 1 0;
    text-align: center;
}

.sidebar-section-title {
    text-style: bold;
    color: #7aa2f7;
    padding: 0 0 0 0;
}

#lecture-tree {
    height: auto;
    max-height: 12;
    padding: 0 0 1 0;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
    scrollbar-color-active: #565f89;
}

#sandbox-tree {
    height: auto;
    max-height: 8;
    padding: 0 0 1 0;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
    scrollbar-color-active: #565f89;
}

#lecture-tree > .tree--cursor,
#sandbox-tree > .tree--cursor {
    background: #292e42;
    color: #FEC62E;
}

#lecture-tree > .tree--highlight,
#sandbox-tree > .tree--highlight {
    background: #292e42;
}

#schema-section {
    height: 1fr;
    padding: 1 0 0 0;
    border-top: solid #292e42;
}

#schema-title {
    text-style: bold;
    color: #7aa2f7;
    padding: 0 0 1 0;
}

#schema-tree {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
    scrollbar-color-active: #565f89;
}

/* ─── Content Area ─── */
#content-area {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

/* ─── Task Panel (Adaptive Height with Scroll) ─── */
#task-panel {
    height: auto;
    min-height: 3;
    max-height: 14;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
    background: #1e2030;
    border-bottom: solid #292e42;
    padding: 1 2;
}

#task-header {
    layout: horizontal;
    height: auto;
}

#task-title {
    width: 1fr;
    text-style: bold;
    color: #bb9af7;
}

#task-progress {
    width: auto;
    color: #565f89;
}

#task-instruction {
    padding: 1 0 0 0;
    color: #c0caf5;
}

#task-hint {
    margin: 1 0 0 0;
    padding: 0 1;
    color: #e0af68;
    background: #1f2335;
    border-left: solid #e0af68;
    display: none;
}

/* ─── Editor Tabs (Flex 1fr) ─── */
#editor-tabs {
    height: 1fr;
    min-height: 4;
}

#editor-tabs > Tabs {
    background: #1e2030;
    border-bottom: solid #292e42;
    height: 2;
    padding: 0 1;
}

#editor-tabs Tab {
    color: #565f89;
    padding: 0 2;
}

#editor-tabs Tab.-active {
    color: #FEC62E;
    text-style: bold;
}

#editor-tabs Tab:hover {
    color: #c0caf5;
}

#editor-tabs ContentSwitcher {
    height: 1fr;
    padding: 0;
}

#editor-tabs TabPane {
    padding: 0;
    height: 1fr;
}

/* ─── Editor Section ─── */
#editor-section {
    height: 1fr;
    layout: vertical;
}

#editor-header-bar {
    height: 1;
    layout: horizontal;
    background: #24283b;
    padding: 0 1;
}

#editor-label {
    width: 1fr;
    color: #7aa2f7;
    text-style: bold;
}

#editor-status-indicator {
    width: auto;
    color: #565f89;
}

#sql-editor {
    height: 1fr;
    min-height: 2;
    border: none;
}

#run-bar {
    height: 1;
    layout: horizontal;
    background: #1f2335;
    padding: 0 1;
}

#run-hint {
    width: 1fr;
    color: #565f89;
}

#intellisense-bar {
    width: auto;
    color: #FEC62E;
    text-style: bold;
}

/* ─── ERD Display ─── */
#erd-display {
    height: 1fr;
    padding: 1 2;
    color: #c0caf5;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
}

/* ─── Results Tabs (Flex 1fr) ─── */
#results-tabs {
    height: 1fr;
    min-height: 4;
    border-top: solid #292e42;
}

#results-tabs > Tabs {
    background: #1e2030;
    border-bottom: solid #292e42;
    height: 2;
    padding: 0 1;
}

#results-tabs Tab {
    color: #565f89;
    padding: 0 2;
}

#results-tabs Tab.-active {
    color: #7aa2f7;
    text-style: bold;
}

#results-tabs Tab:hover {
    color: #c0caf5;
}

#results-tabs ContentSwitcher {
    height: 1fr;
    padding: 0;
}

#results-tabs TabPane {
    padding: 0;
    height: 1fr;
}

/* ─── Results Section ─── */
#results-section {
    height: 1fr;
    layout: vertical;
}

#results-header {
    height: 1;
    layout: horizontal;
    background: #24283b;
    padding: 0 1;
}

#results-title {
    width: 1fr;
    color: #7aa2f7;
    text-style: bold;
}

#results-stats {
    width: auto;
    color: #565f89;
}

#results-table {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
}

DataTable {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
    scrollbar-color-active: #565f89;
}

DataTable > .datatable--cursor {
    background: #292e42;
    color: #FEC62E;
}

DataTable > .datatable--header {
    background: #24283b;
    color: #7aa2f7;
    text-style: bold;
}

#feedback-bar {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 1;
    background: #16161e;
}

.feedback-pass {
    color: #9ece6a;
    text-style: bold;
}

.feedback-fail {
    color: #f7768e;
}

.feedback-error {
    color: #e0af68;
}

.feedback-idle {
    color: #565f89;
}

/* ─── Preview Display ─── */
#preview-display {
    height: 1fr;
    padding: 1 2;
    color: #c0caf5;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
}

/* ─── Input (New DB Prompt) ─── */
#new-db-input {
    height: 3;
    margin: 0 1;
    background: #24283b;
    color: #c0caf5;
    border: tall #7aa2f7;
}

#new-db-input:focus {
    border: tall #FEC62E;
}

/* ─── Confirmation Modal Dialog ─── */
ResetConfirmationModal, UpdatePromptModal, ImportFileDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
    layer: modal;
}

#confirm-dialog, #update-dialog, #import-dialog {
    width: 62;
    max-width: 90%;
    height: auto;
    background: #1e2030;
    border: tall #f7768e;
    padding: 1 2;
}

#import-dialog {
    border: tall #e0af68;
}

#import-title {
    text-style: bold;
    color: #e0af68;
    text-align: center;
    padding-bottom: 1;
}

#import-hint-text {
    color: #565f89;
    padding-bottom: 1;
}

#import-path, #import-name {
    margin-bottom: 1;
}

#update-dialog {
    border: tall #73daca;
}

#confirm-title {
    text-style: bold;
    color: #f7768e;
    text-align: center;
    padding-bottom: 1;
}

#update-title {
    text-style: bold;
    color: #73daca;
    text-align: center;
    padding-bottom: 1;
}

#update-version-info {
    text-align: center;
}

#update-notes {
    color: #565f89;
    padding: 1 0;
}

#update-status {
    text-align: center;
    padding: 1 0;
}

#confirm-message {
    color: #c0caf5;
    text-align: center;
    padding-bottom: 1;
}

#confirm-buttons, #update-buttons, #import-buttons {
    align: center middle;
    height: auto;
}

#confirm-buttons Button, #update-buttons Button, #import-buttons Button {
    margin: 0 1;
}

/* ─── Global Scrollbars ─── */
Scrollbar {
    background: #16161e;
    color: #292e42;
}

ScrollbarThumb {
    background: #414868;
}

ScrollbarThumb:hover {
    background: #565f89;
}

Tree {
    background: transparent;
    scrollbar-size: 1 1;
    scrollbar-color: #292e42;
    scrollbar-color-hover: #414868;
}

Tree > .tree--cursor {
    background: #292e42;
    color: #FEC62E;
}

Tree > .tree--guides {
    color: #292e42;
}
